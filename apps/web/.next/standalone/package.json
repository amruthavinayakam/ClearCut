{
  "name": "clearcut",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/web",
    "packages/contracts",
    "packages/ui"
  ],
  "scripts": {
    "dev": "bun --filter @clearcut/web dev",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "bun --filter '*' lint",
    "test": "bun --filter @clearcut/contracts test && bun --filter @clearcut/web test",
    "build": "bun --filter @clearcut/web build",
    "cf:typegen": "bun --filter @clearcut/web cf:typegen",
    "cf:check": "bun --filter @clearcut/web cf:check",
    "cf:deploy": "bun --filter @clearcut/web cf:deploy"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "6.x"
  }
}
