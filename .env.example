# Copy to `.env` and fill in. Never commit `.env`.

# Agent providers. Required only when MOCK_RESEARCH=false.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PARALLEL_API_KEY=
# Task processor: lite < base < core < pro. Latency and depth both rise
# with it; `core` runs about four minutes per case.
PARALLEL_PROCESSOR=base
PARALLEL_MONITOR_PROCESSOR=lite

# Local deterministic mode. Every fixture result is visibly prefixed MOCK:.
MOCK_RESEARCH=false

# Pipeline and assets.
RESEARCH_CONCURRENCY=32
# Cap on one case's structured research. The slowest case sets how long a
# production takes; lower this to bound the wait and accept more gaps.
# fast: Parallel Search retrieves, a Gemini agent reasons over the results (seconds per case).
# deep: each case goes to a Parallel Task that searches again itself (minutes per case).
RESEARCH_DEPTH=fast
# Unset means the depth's own budget applies: 90s for fast, 5min for deep.
# CASE_RESEARCH_TIMEOUT_MS=300000
ASSET_STORAGE_DIR=.clearcut/assets
PROJECT_STORAGE_DIR=.clearcut/projects
FFPROBE_PATH=ffprobe
MAX_UPLOAD_BYTES=209715200

# Bun API. Portless supplies PORT during `bun run dev`.
HOST=127.0.0.1
# PORT=3001

# Next development rewrite target.
CLEARCUT_API_ORIGIN=https://clearcut-api.lcl

# Parallel Monitor webhook delivery.
PUBLIC_BASE_URL=
PARALLEL_WEBHOOK_SECRET=

# Supplied by the Cloudflare edge runtime in production.
CLOUDFLARE_BINDING_ORIGIN=
CLOUDFLARE_BINDING_NONCE=
