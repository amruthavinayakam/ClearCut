# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Google Cloud / Vertex AI ------------------------------------------------
# Your GCP project id (the lowercase id, not the display name).
GOOGLE_CLOUD_PROJECT=
# `global` works for most Gemini models; pin a region if you need to.
GOOGLE_CLOUD_LOCATION=global
# TRUE  -> Vertex AI with Application Default Credentials.
# FALSE -> AI Studio with GOOGLE_API_KEY below.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_API_KEY=

# Leave blank to probe for a model this project can serve; set to pin one.
GEMINI_MODEL=

# Optional. When set, rough cuts are uploaded here and Gemini reads them by URI
# instead of inline. Required for cuts larger than ~18 MB.
GCS_BUCKET=

# --- Parallel ----------------------------------------------------------------
# https://platform.parallel.ai -> API keys
PARALLEL_API_KEY=

# Search: live retrieval shown in the UI. turbo | basic | advanced
PARALLEL_SEARCH_MODE=basic
PARALLEL_SEARCH_MAX_CHARS=12000

# Task: the structured dossier. lite | base | core | pro | ultra
PARALLEL_PROCESSOR=core

# Monitor: standing watch. lite | base
PARALLEL_MONITOR_PROCESSOR=base
PARALLEL_TIMEOUT_S=900

# A `core` run takes ~3-4 minutes, so this decides whether a project finishes in
# five minutes or forty. The work is I/O-bound, so a high number costs nothing.
RESEARCH_CONCURRENCY=16

# --- Behaviour ---------------------------------------------------------------
# true -> serve fixture research instead of calling (and billing) Parallel.
MOCK_RESEARCH=false
# true -> persist projects and audit trail in Firestore.
USE_FIRESTORE=false
FIRESTORE_COLLECTION=clearance_projects

# --- Server ------------------------------------------------------------------
PORT=8080
# Public HTTPS origin of this deployment. Required for Parallel Monitor webhooks
# to reach you — leave blank locally and poll instead.
PUBLIC_BASE_URL=
# If set, incoming webhooks must send a matching `x-radar-secret` header.
PARALLEL_WEBHOOK_SECRET=
MAX_UPLOAD_BYTES=209715200
