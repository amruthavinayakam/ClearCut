# What Cloud Build needs to see: requirements.txt, backend/, tools/, frontend/
# (for the Docker UI build stage). Everything else is dead weight for this
# deploy — the Next.js app ships separately to Cloudflare.

.git/
.gitignore
.gcloudignore

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

.env
.env.local
.env.example

node_modules/
/apps/
/packages/
/bun.lock
/package.json
/tsconfig.base.json
apps/web/open-next.config.ts

fixtures/
docs/
plans/
idea.md

.DS_Store
uploads/
.last_project
.claude/
